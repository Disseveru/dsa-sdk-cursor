# Ethereum RPC (required for agent and node.js mode)
ETH_NODE_URL=https://mainnet.infura.io/v3/{API_KEY}

# Wallet for DSA spell casting
PUBLIC_ADDRESS={PUBLIC_ADDRESS}
PRIVATE_KEY={PRIVATE_KEY}

# Agent settings (see agent/.env.example for full list)
DSA_ID=
SCAN_INTERVAL_MS=30000
MIN_PROFIT_USD=5
DRY_RUN=true
ENABLE_ARBITRAGE=true
ENABLE_LIQUIDATIONS=true
