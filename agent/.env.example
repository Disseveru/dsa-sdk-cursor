# Ethereum RPC endpoint (optional — defaults to https://ethereum.publicnode.com)
ETH_NODE_URL=https://mainnet.infura.io/v3/YOUR_API_KEY

# Wallet that owns the DSA (optional — auto-derived from PRIVATE_KEY / EOA_PRIVATE_KEY)
PUBLIC_ADDRESS=0xYourWalletAddress

# Private key for autonomous spell casting (optional — cloud secrets EOA_PRIVATE_KEY also work)
PRIVATE_KEY=0xYourPrivateKey

# DSA account ID (optional — auto-detected from PUBLIC_ADDRESS if omitted)
DSA_ID=

# Agent behavior
SCAN_INTERVAL_MS=30000
MIN_PROFIT_USD=5
SLIPPAGE_PERCENT=2
MIN_BORROW_DAI=20
DRY_RUN=true
ENABLE_ARBITRAGE=true
ENABLE_LIQUIDATIONS=true
